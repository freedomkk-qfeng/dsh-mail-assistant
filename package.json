{
  "name": "dsh-mail-assistant",
  "version": "0.1.0-alpha.4",
  "description": "Standards-based IMAP/SMTP mail assistant for DeepSeek Harness with explicit read/send controls and approval-aware delivery",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "email",
    "imap",
    "smtp",
    "mail-assistant"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*.js",
    "docs/**/*.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE",
    "SECURITY.md",
    "SECURITY.en.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_NOTICES.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:host": "tsdown --config tsdown.host.config.ts",
    "build:client": "tsdown",
    "build": "npm run clean && npm run build:host && npm run build:client",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:bundle": "node scripts/check-host-bundle.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run check:bundle && npm run check:docs && npm run check:secrets && npm run check:licenses && npm pack --dry-run",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freedomkk-qfeng/dsh-mail-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/freedomkk-qfeng/dsh-mail-assistant/issues"
  },
  "homepage": "https://github.com/freedomkk-qfeng/dsh-mail-assistant#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-permission-presets": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-permission-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.28",
    "imapflow": "^1.7.0",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "react": "^18.3.1",
    "schemastery": "^3.18.0",
    "tsdown": "0.22.14",
    "typescript": "^5.9.3"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "dependencies": {
    "ansis": "^4.3.1",
    "atomic-sleep": "^1.0.0",
    "cac": "^7.0.0",
    "cosmokit": "^1.8.1",
    "csstype": "^3.2.3",
    "deepmerge-ts": "^8.0.2",
    "defu": "^6.1.7",
    "dom-serializer": "^2.0.0",
    "domelementtype": "^2.3.0",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "dts-resolver": "^3.0.0",
    "empathic": "^2.0.1",
    "encoding-japanese": "^2.2.0",
    "entities": "^4.5.0",
    "fdir": "^6.5.0",
    "get-tsconfig": "^5.0.0-beta.5",
    "he": "^1.2.0",
    "hookable": "^6.1.1",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^10.1.0",
    "iconv-lite": "^0.7.3",
    "import-without-cache": "^0.4.0",
    "ip-address": "^10.7.0",
    "js-tokens": "^4.0.0",
    "leac": "^0.7.0",
    "libbase64": "^1.3.0",
    "libmime": "^5.4.2",
    "libqp": "^2.1.1",
    "linkify-it": "^5.0.2",
    "loose-envify": "^1.4.0",
    "obug": "^2.1.4",
    "on-exit-leak-free": "^2.1.2",
    "parseley": "^0.13.1",
    "peberminta": "^0.10.0",
    "picomatch": "^4.0.7",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "pino-std-serializers": "^7.1.0",
    "process-warning": "^5.1.0",
    "punycode.js": "^2.3.1",
    "quansync": "^1.0.0",
    "quick-format-unescaped": "^4.0.4",
    "real-require": "^0.2.0",
    "resolve-pkg-maps": "^1.0.0",
    "rolldown": "^1.2.6",
    "rolldown-plugin-dts": "^0.27.14",
    "safe-stable-stringify": "^2.5.0",
    "safer-buffer": "^2.1.2",
    "selderee": "^0.12.0",
    "smart-buffer": "^4.2.0",
    "socks": "^2.8.9",
    "sonic-boom": "^4.2.1",
    "split2": "^4.2.0",
    "thread-stream": "^4.2.0",
    "tinyexec": "^1.3.0",
    "tinyglobby": "^0.2.17",
    "tlds": "^1.261.0",
    "tree-kill": "^1.2.2",
    "uc.micro": "^2.1.0",
    "unconfig-core": "^7.5.0",
    "undici-types": "^8.3.0",
    "verkit": "^0.3.2",
    "yuku-ast": "^0.8.7",
    "yuku-codegen": "^0.9.3",
    "yuku-parser": "^0.8.7"
  },
  "author": ""
}
