{
  "name": "@eduwork/dsh-mail",
  "version": "0.1.0-alpha.5",
  "description": "Standards-based IMAP/SMTP mail assistant for DeepSeek Harness with explicit read/send controls and approval-aware delivery",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "email",
    "imap",
    "smtp",
    "mail-assistant"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*.js",
    "docs/**/*.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE",
    "SECURITY.md",
    "SECURITY.en.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_NOTICES.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:host": "tsdown --config tsdown.host.config.ts",
    "build:client": "tsdown",
    "build": "npm run clean && npm run build:host && npm run build:client",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:bundle": "node scripts/check-host-bundle.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run check:bundle && npm run check:docs && npm run check:secrets && npm run check:licenses && npm pack --dry-run",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freedomkk-qfeng/dsh-mail-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/freedomkk-qfeng/dsh-mail-assistant/issues"
  },
  "homepage": "https://github.com/freedomkk-qfeng/dsh-mail-assistant#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-permission-presets": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-permission-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.28",
    "imapflow": "^1.7.0",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "react": "^18.3.1",
    "schemastery": "^3.18.0",
    "tsdown": "0.22.14",
    "typescript": "^5.9.3"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "author": ""
}
